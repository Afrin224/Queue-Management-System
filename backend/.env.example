# Django loads this backend/.env file automatically.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
ENABLE_DEMO=true

# Copy your PostgreSQL URI from Supabase -> Connect and replace its password.
# DATABASE_URL=postgresql://postgres:URL_ENCODED_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
DJANGO_DB_CONN_MAX_AGE=60

# Used by the optional Supabase connectivity check.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Required with DJANGO_DEBUG=false.
# DJANGO_SECRET_KEY=
# DJANGO_CSRF_TRUSTED_ORIGINS=https://queueflow.example.com
